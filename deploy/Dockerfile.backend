# Build Stage
FROM golang:1.24-alpine AS builder

# Install build dependencies for CGO (required by tree-sitter)
RUN apk --no-cache add gcc g++ musl-dev

WORKDIR /app

# Dependency Caching
COPY go.mod go.sum ./
RUN go mod download

# Source Code
COPY . .

# Build Orchestrator
RUN go build -o /bin/orchestrator ./cmd/orchestrator/main.go

# Build Worker
RUN go build -o /bin/worker ./cmd/worker/main.go

# Production Stage
FROM alpine:latest

WORKDIR /app

# Install Node.js for TestRunner activity (runs Vitest tests)
RUN apk --no-cache add ca-certificates nodejs npm bash

# Copy Binaries
COPY --from=builder /bin/orchestrator /app/orchestrator
COPY --from=builder /bin/worker /app/worker

# Create entrypoint script to run both worker and orchestrator
RUN echo '#!/bin/bash' > /app/entrypoint.sh && \
    echo '/app/worker &' >> /app/entrypoint.sh && \
    echo 'exec /app/orchestrator' >> /app/entrypoint.sh && \
    chmod +x /app/entrypoint.sh

# Expose API Port
EXPOSE 8080

# Run both worker and orchestrator
CMD ["/app/entrypoint.sh"]
